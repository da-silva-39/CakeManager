<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView android:id="@+id/textType" android:layout_width="80dp" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/pink_primary" />
        <TextView android:id="@+id/textQuantity" android:layout_width="60dp" android:layout_height="wrap_content" />
        <TextView android:id="@+id/textDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/chocolate_light" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
